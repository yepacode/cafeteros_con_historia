<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Cámara declarada como NO requerida: la app funciona sin cámara (el
      caficultor puede subir fotos desde la galería). Pero permitimos que
      Android la use cuando esté disponible. No declaramos
      <uses-permission android:name="android.permission.CAMERA" /> porque
      delegamos en la app de cámara del sistema vía Intent.ACTION_IMAGE_CAPTURE,
      lo cual no requiere ese permiso a nivel de nuestra app.
    -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!--
      Android 11+ (API 30) introdujo "package visibility": las apps no pueden
      lanzar intents implícitos a otras apps si no declaran que las van a
      consultar. Sin este bloque, ActivityResultContracts.TakePicture()
      retorna success=false silenciosamente porque no encuentra resolver.
    -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:name=".CafeterosApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cafeteros">

        <activity
            android:name=".ui.features.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Cafeteros">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.features.onboarding.OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.Cafeteros" />

