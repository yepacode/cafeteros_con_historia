<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Permisos de red: requeridos por Firebase (Auth/Firestore/Storage),
      por la pasarela ePayco y por la descarga de tiles de OpenStreetMap.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Geolocalización: el comprador puede pulsar "Usar mi ubicación" en el
      checkout para auto-rellenar lat/lng y dirección. Pedimos ambos niveles
      de precisión; si el usuario solo concede COARSE, lo seguimos usando
      pero con menor exactitud.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
      osmdroid recomienda WAKE_LOCK para que el dispositivo no entre a
      doze mientras se renderizan tiles del mapa, especialmente en
      sesiones largas de selección de punto.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      Cámara declarada como NO requerida: la app funciona sin cámara (el
      caficultor puede subir fotos desde la galería). Pero permitimos que
      Android la use cuando esté disponible. No declaramos
      <uses-permission android:name="android.permission.CAMERA" /> porque
      delegamos en la app de cámara del sistema vía Intent.ACTION_IMAGE_CAPTURE,
      lo cual no requiere ese permiso a nivel de nuestra app.
    -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!--
      Android 11+ (API 30) introdujo "package visibility": las apps no pueden
      lanzar intents implícitos a otras apps si no declaran que las van a
      consultar. Sin este bloque, ActivityResultContracts.TakePicture()
      retorna success=false silenciosamente porque no encuentra resolver.
    -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

